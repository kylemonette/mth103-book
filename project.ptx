<?xml version="1.0" encoding="utf-8"?>

<project ptx-version="2">
<targets>

<!-- <target name="web" format="html" source="main.ptx" publication="publication.ptx" xsl="pretext-html.xsl" deploy-dir="web"> -->
<target name="web" format="html" source="main.ptx" publication="publication.ptx">
<stringparams author.tools="yes" html.css.extra="external/custom.css" />
</target>


<!-- <target name="print" format="pdf" output-dir="print" output-filename="applied-precalculus.pdf" publication="print.ptx" xsl="pretext-latex.xsl" deploy-dir="print"> -->
<target name="print" format="pdf" output-dir="print" output-filename="applied-precalculus.pdf" publication="print.ptx" xsl="pretext-latex.xsl">
<!-- <stringparams draft="yes"/> -->
</target>



<target name="runestone" source="main.ptx" publication="runestone.ptx" format="html">
<stringparams html.css.extra="external/custom.css" />
</target>


</targets>
</project>